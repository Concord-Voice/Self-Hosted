# spa.env: remote SPA settings, read by the control plane through the
# env_file entry in docker-compose.yml, which requires this file to exist.
# Self-hosted default: both streams are disabled; clients use their bundled
# renderer. Configure a stream only if you serve a compatible remote SPA.
#
# SPA_URL / SPA_PRERELEASE_URL: Stable / Pre-Release remote SPA URL.
# *_IPC_CONTRACT: Positive minimum IPC contract required by an enabled stream.
# *_VERSION: Optional deployment audit ID (up to 128 ASCII letters, digits,
# dots, underscores, plus signs or hyphens); not publisher authorization.
# A disabled stream has an empty URL/version and an empty or zero contract.
# For SPA_CONFIG_FILE hot reload, replace the whole file using an atomic
# rename from the same directory. An omitted stream is disabled on reload.
SPA_URL=
SPA_IPC_CONTRACT=0
SPA_VERSION=
SPA_PRERELEASE_URL=
SPA_PRERELEASE_IPC_CONTRACT=0
SPA_PRERELEASE_VERSION=
