# spa.env: remote SPA settings, read by the control plane through the
# env_file entry in docker-compose.yml, which requires this file to exist.
# Self-hosted default: an empty SPA_URL means every desktop client uses its
# bundled renderer. Set SPA_URL only if you serve a compatible remote SPA.
#
# SPA_URL: Remote SPA URL served to compatible desktop shells.
# SPA_IPC_CONTRACT: Minimum IPC contract version the remote SPA requires.
# SPA_VERSION: Git SHA short hash identifying the SPA build.
SPA_URL=
SPA_IPC_CONTRACT=0
SPA_VERSION=
