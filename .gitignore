# ============================================================================
# DOCUMENTATION FILES - ALWAYS COMMIT (DO NOT IGNORE)
# ============================================================================
# The following files SHOULD be tracked in git:
# - LICENSE (BSL 1.1 license file)
# - README.md, [internal], ROADMAP.md, FAQ.md, AI-CONTEXT.md
# - docs/*.md (all documentation)
# - docs/archive/*.md (archived legacy documentation)
# These are explicitly NOT ignored below.

# ============================================================================
# Operating System Files
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# iCloud Drive conflict duplicates (macOS creates "file 2.ext" copies)
* 2.*
* 3.*

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.swn
.vim/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Environment Variables (CRITICAL - NEVER COMMIT)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
*.env
!.env.example
!spa.env

# Secret rotation scripts (contain connection string templates)
scripts/rotate-secrets.sh

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json
!client/desktop/package-lock.json
!services/media-plane/package-lock.json
yarn.lock
pnpm-lock.yaml

# Build Outputs
dist/
build/
!client/desktop/build/
out/
client-builds/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# tsc output alongside source (main-process build emits .js/.d.ts into src/)
client/desktop/src/shared/**/*.js
client/desktop/src/shared/**/*.js.map
client/desktop/src/shared/**/*.d.ts
client/desktop/src/shared/**/*.d.ts.map
client/desktop/src/main/**/*.js
client/desktop/src/main/**/*.js.map
client/desktop/src/main/**/*.d.ts
client/desktop/src/main/**/*.d.ts.map

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
vendor/
bin/
services/control-plane/server
services/control-plane/migrate-media
client/desktop/Helper
coverage.txt
*.prof

# Rust (if used for native modules)
target/
Cargo.lock
**/*.rs.bk
*.pdb

# Database
*.db
*.sqlite
*.sqlite3
data/
!client/desktop/src/renderer/data/
!client/desktop/src/renderer/data/emoji/
!client/desktop/src/renderer/data/emoji/**
postgres-data/
redis-data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
coverage/
*.cover
.nyc_output/
test-results/
playwright-report/
junit.xml

# Docker
*.dockerignore
docker-compose.override.yml

# Kubernetes Secrets
*secret*.yaml
*secrets*.yaml

# Certificates and Keys
*.pem
*.key
*.crt
*.p12
*.pfx
keys/
certs/
# Track the coturn cert mount point (placeholder + README) so the bind
# mount in docker-compose.yml succeeds on a fresh clone. Real cert/key
# files are still ignored by the *.pem / *.key rules above.
!infrastructure/docker/coturn/certs/
!infrastructure/docker/coturn/certs/.gitkeep
!infrastructure/docker/coturn/certs/README.md

# Media Files (for testing)
*.mp3
*.wav
*.mp4
*.avi
uploads/

# Allow bundled notification sounds
!client/desktop/public/sounds/*.wav

# Temporary Files
tmp/
temp/
*.tmp
*.temp
.cache/

# License Files (sensitive)
licenses/*.key
licenses/*.license

# Monitoring and Telemetry
.prometheus/
.grafana/

# Process IDs
.pids/
*.pid

# Security-Critical Files (NEVER COMMIT)
id_rsa
id_rsa.pub
id_dsa
id_ecdsa
*.ppk
credentials.json
service-account.json
service-account-*.json
*-credentials.json
auth.json
secrets.json
config.production.json
.npmrc
.pypirc

# AWS
.aws/
*.pem
aws-exports.js

# Google Cloud
*-key.json
gcloud-service-key.json

# Session storage (root-level only, not internal/sessions/)
/.sessions/
/sessions/
.dev-data/
