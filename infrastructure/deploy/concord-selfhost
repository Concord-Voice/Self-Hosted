#!/usr/bin/env bash
# Concord Voice — self-hosted operator CLI (#1616).
# Day-2 lifecycle/monitoring for a self-hosted instance. Thin wrapper over the
# production compose stack. Operator analogue of concord-ctl.sh, minus the
# Actions-pipeline verbs (sync-releases, verify-registration, sudoers-sync, nginx-reload).
#
# Usage: ./infrastructure/deploy/concord-selfhost <verb> [args]
#   Run from the repo root (compose auto-loads ./.env). Migrations auto-run at startup.
#
# Exit codes: 0 ok | 1 runtime / unknown verb
set -euo pipefail

# ── Constants ──────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
readonly PROJECT_ROOT
CONCORD_CTL="${CONCORD_CTL_OVERRIDE:-$SCRIPT_DIR/concord-ctl.sh}"
readonly CONCORD_CTL

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

# Production compose stack: base + production overlay + services profile.
# Verified against docker-compose.yml / docker-compose.production.yml in the repo.
COMPOSE_FILES=(
  "-f" "$PROJECT_ROOT/docker-compose.yml"
  "-f" "$PROJECT_ROOT/docker-compose.production.yml"
  "-f" "$PROJECT_ROOT/docker-compose.selfhost.yml"
  "--profile" "services"
)

# Reserved for a richer per-service status in a follow-up (#1616 scope).
# ponytail: expand status verb to iterate SERVICES for per-container health loop.
# shellcheck disable=SC2034  # SERVICES is reserved for the follow-up status loop
readonly SERVICES=(control-plane media-plane postgres redis nats minio coturn)

# ── Helpers ────────────────────────────────────────────────────────────

# compose ARGS... — invoke docker compose with the production file set.
compose() { docker compose "${COMPOSE_FILES[@]}" "$@"; }

# guarded_ctl ARGS... — reuse the canonical rollout/rollback state machine in
# a strictly-attested self-host mode. The root installer .env is the sole
# canonical writer; concord-ctl still compares it with rendered production
# Compose and refuses a managed-style deploy.env.local rollout writer.
guarded_ctl() {
  if [[ ! -x "$CONCORD_CTL" ]]; then
    echo -e "${RED}guarded concord-ctl.sh is missing or not executable${NC}" >&2
    return 1
  fi
  ACTIVITY_HISTORY_CONTRACT_MODE=selfhost \
    COMPOSE_OVERRIDE=docker-compose.production.yml \
    COMPOSE_PROFILES=services \
    "$CONCORD_CTL" "$@"
}

usage() {
  cat <<'USAGE'
concord-selfhost — self-hosted operator CLI

Usage: ./infrastructure/deploy/concord-selfhost <verb> [args]

Verbs:
  up           guarded build + start; refuses implicit first activation
               (a previously activated stack restarts via its durable receipt)
  activity-history-activate --confirm-drained
               explicitly activate from a fully drained control-plane set
  activity-history-rollback --confirm-drained --old-image <digest> [--downgrade-schema]
               guarded disable/checkpoint/immutable old-image rollback
  down         stop AND remove containers + network (docker compose down)
  stop         pause containers, leave them in place (docker compose stop)
  status       per-service container state (docker compose ps)
  logs [svc]   tail logs; optional service name to filter
  health       probe control-plane over 127.0.0.1 and check live port bindings
               against the self-host posture (#3538)
  --help       show this help

Run from the repo root. The .env in the repo root is auto-loaded by compose.
Migrations run automatically at control-plane startup.
USAGE
}

verb_health() {
  local code rc=0
  code="$(curl -fsS -o /dev/null -w '%{http_code}' --max-time 5 \
    http://127.0.0.1:8080/api/v1/client/config 2>/dev/null)" || true
  code="${code:-000}"
  if [[ "$code" == "200" ]]; then
    echo -e "${GREEN}✓ control-plane healthy (HTTP 200)${NC}"
  else
    echo -e "${RED}✗ control-plane unhealthy (HTTP $code)${NC}" >&2
    rc=1
  fi
  if guarded_ctl selfhost-port-check; then
    echo -e "${GREEN}✓ published ports match the self-host posture${NC}"
  else
    echo -e "${RED}✗ published-port posture check failed (see above)${NC}" >&2
    rc=1
  fi
  return "$rc"
}

# ── Verb dispatch ──────────────────────────────────────────────────────

main() {
  case "${1:-}" in
    up)         guarded_ctl rebuild ;;
    activity-history-activate)
      shift
      guarded_ctl activity-history-activate "$@"
      ;;
    activity-history-rollback)
      shift
      guarded_ctl activity-history-rollback "$@"
      ;;
    down)       compose down ;;
    stop)       compose stop ;;
    status)     compose ps ;;
    logs)       shift; compose logs -f "$@" ;;
    health)     verb_health ;;
    --help|-h|"") usage ;;
    *)
      echo -e "${RED}unknown verb: $1${NC}" >&2
      usage >&2
      return 1
      ;;
  esac
}

# ── Source-vs-execute guard ────────────────────────────────────────────
# Tests do `source concord-selfhost` to call helpers without running main.

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
