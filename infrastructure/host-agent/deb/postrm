#!/bin/sh
# Concord Voice self-hosted package (#187). /opt/concord is never removed.
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
  deb-systemd-helper purge concord-agent.service >/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
  fi
fi
