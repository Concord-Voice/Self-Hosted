{
  "default_branch": "main",
  "migrations": {
    "dir": "services/control-plane/migrations/"
  },
  "hooks": {
    "protected_patterns": [
      "/crypto",
      "/e2ee",
      "/auth/",
      "/mfa/",
      "/rbac/",
      "internal/(authority|oauth|entitlements|middleware|sessions|stepup|credepoch|keyrotation|mfaenforce|loginfamily|accountguard|attestation|devicerecovery|securityevent)/",
      "redis-auth-controller",
      "voiceauthprotocol",
      "docker-compose\\.(production|selfhost|byo-s3)\\.yml$",
      "\\.github/workflows/",
      "\\.github/scripts/",
      "\\.pre-commit-config\\.yaml$",
      "\\.secrets\\.baseline$",
      "infrastructure/",
      "scripts/security/",
      "CODEOWNERS$",
      "(^|/)\\.claude/(hooks/|settings\\.json|repo-config\\.json|\\.agentic-dev-tooling\\.lock$)",
      "scripts/repo-config\\.sh$"
    ]
  },
  "feedback_triage": {
    "public": "Concord-Voice/Feedback",
    "tracker": "Concord-Voice/Self-Hosted",
    "routing": {
      "desktop": "Concord-Voice/Desktop",
      "mobile": "Concord-Voice/Mobile",
      "self-hosted": "Concord-Voice/Self-Hosted",
      "hosted": "Concord-Voice/Hosted",
      "release-ops": "Concord-Voice/Release-Ops",
      "internal-tooling": "Concord-Voice/Internal-Dev-Tooling"
    },
    "sentinel_prefix": "concord-feedback-triage"
  }
}
