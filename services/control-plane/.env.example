# Concord Voice Control Plane - Environment Variables Template
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgres://concord:your_password_here@localhost:5432/concord?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_secret_key_here

# Server Configuration
PORT=8080
ENVIRONMENT=development

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Optional: Rate Limiting
RATE_LIMIT_ENABLED=true

# Optional: NATS Configuration (for future use)
# NATS_URL=nats://localhost:4222

# Sentry observability (opt-in, all six vars optional)
# Leave SENTRY_DSN_CONTROL unset to disable Sentry — the privacy erasure
# endpoint downgrades to a no-op stub. To enable Sentry in production set
# SENTRY_DSN_CONTROL plus the three admin credentials. Set SENTRY_ENABLED=true
# to require the DSN at startup (typo guard against silently disabling Sentry).
# See [internal]specs/2026-04-16-679-sentry-guard-dsn-aware-design.md
# SENTRY_DSN_CONTROL=https://<key>@<host>/<project>
# SENTRY_ADMIN_TOKEN=
# SENTRY_ORG_SLUG=
# SENTRY_PROJECT_SLUG=
# SENTRY_API_BASE=https://sentry.io
# SENTRY_ENABLED=
