# Match go.mod's toolchain (falling back to its go directive); checked by
# scripts/check-go-toolchain.py alongside the control-plane Dockerfile.
FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src

COPY go.mod go.sum ./
# Same cache targets as the control-plane Dockerfile; see the note there.
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ops-agent ./cmd/ops-agent

FROM scratch

LABEL org.opencontainers.image.source="https://github.com/Concord-Voice/Self-Hosted"
LABEL org.opencontainers.image.description="Concord Voice isolated operations metrics agent"
LABEL org.opencontainers.image.licenses="LicenseRef-CVSL-1.0"

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/ops-agent /ops-agent

# Root is required for the isolated host Docker socket; Compose drops all capabilities.
USER 0:0

ENTRYPOINT ["/ops-agent"]
